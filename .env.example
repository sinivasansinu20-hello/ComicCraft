# ==============================================================================
# ComicCraft Environment Configuration Template
# Copy this file to .env and insert your API keys
# ==============================================================================

# Google Gemini API Key (Required for outline planning and narrative writing)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Token (Required for FLUX.1-schnell / SDXL image generation)
# Get a free token at https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here

# Model Identifiers
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-3.6-flash
SD_MODEL_ID=black-forest-labs/FLUX.1-schnell

# Application Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Storage & Output Directories
PANELS_DIR=static/panels
EXPORTS_DIR=static/exports
